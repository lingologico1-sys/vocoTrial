node_modules/
dist/
.wrangler/
.dev.vars
.env
*.local
# Vite's temporary config-loading artifact
*.timestamp-*.mjs
# Per-machine Claude Code overrides; shared settings live in .claude/settings.json
.claude/settings.local.json
# Kits exported from /facekit, which land wherever the browser drops them. The
# one face this repo ships is unpacked into public/faces/, not the archive.
*.zip

# TypeScript's incremental build caches, one per project. Written by any
# local typecheck and meaningless on another machine.
*.tsbuildinfo

# The lip-sync backend's Python venv, caches and generated media.
#
# The code is committed and small; everything below is reproducible. The wavs and
# JSON in assets/ are ~8MB of ElevenLabs output and bake results, regenerated by
# `modal run lipsync/lip_sync_api.py`. The .txt scripts beside them are NOT ignored:
# they are the input those recordings were made from, preflight.py reads them, and
# they are the part that would be painful to reconstruct.
lipsync/.venv/
lipsync/__pycache__/
lipsync/assets/*.wav
lipsync/assets/*.mp3
lipsync/assets/*.json
lipsync/*-frames/
lipsync/*.png
lipsync/*.jpg
