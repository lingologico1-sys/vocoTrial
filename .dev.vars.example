# Copy to .dev.vars (gitignored) and paste in real values for `npm run dev:api`.
# In production these live in the Pages dashboard as encrypted Secrets — never
# in wrangler.toml, which is committed.

# The site password. Without it every /api/* route refuses everyone, including
# you: the gate fails closed on purpose, so an unset secret is never "open".
SITE_PASSWORD=...

# Face-kit image generation only. The voice path was Gemini-only as of the
# OpenAI Realtime removal, so leaving this unset costs you the OpenAI image
# models on /facekit and nothing else.
OPENAI_API_KEY=sk-...

# Google runs on Vertex AI (GCP billing), not AI Studio — the same keys
# PanelForge uses in bannerMaker, off the same project. Primary then fallback;
# one of the two is enough. An AI Studio key will not work here: Vertex refuses
# it outright rather than falling back to the other surface.
GEMINI_API_KEY=...
GEMINI_API_KEY2=...

# AI Studio, for the models Vertex does not carry — 3.1 Flash Live has no Vertex
# build in any region. An ordinary API key, not a service-account-bound one:
# AI Studio has no such notion, which is precisely why Vertex refuses these.
# Not a fallback for the keys above; it reaches a different catalogue.
GOOGLE_API_KEY=...
